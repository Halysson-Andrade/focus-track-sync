{
  "manifest_version": 3,
  "name": "Monitor de Atividade",
  "version": "1.0.0",
  "description": "Registra navegação no Chrome para o painel de produtividade.",
  "permissions": ["tabs", "storage", "idle", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon128.png" },
  "icons": { "16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png" }
}
