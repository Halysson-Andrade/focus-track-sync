{
  "manifest_version": 3,
  "name": "Monitor de Atividade",
  "version": "1.6.2",
  "description": "Registra navegação no Chrome e apontamento de atividades por item para o painel de produtividade.",
  "permissions": ["tabs", "storage", "idle", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://focus-track-sync.lovable.app/*",
        "https://*.lovable.app/*",
        "https://*.lovableproject.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://trello.com/*",
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*",
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["activity-widget.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
